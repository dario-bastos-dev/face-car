{
  "versao": 8,
  "mediapipe": {
    "modelo": "modelos/face_landmarker.task",
    "min_confianca_deteccao": 0.5,
    "min_confianca_presenca": 0.5,
    "min_confianca_rastreio": 0.5,
    "max_rostos": 3
  },
  "camera_padrao": "rgb",
  "cameras": [
    {
      "nome": "rgb",
      "descricao": "colorida (HD Webcam)",
      "dispositivo": "/dev/v4l/by-path/pci-0000:00:14.0-usb-0:5:1.0-video-index0",
      "largura": 640,
      "altura": 480
    },
    {
      "nome": "ir",
      "descricao": "infravermelha (IR Camera)",
      "dispositivo": "/dev/v4l/by-path/pci-0000:00:14.0-usb-0:5:1.2-video-index0",
      "largura": null,
      "altura": null
    }
  ],
  "classificador": {
    "modelo": "cnn_sonolencia.keras",
    "classes": [
      "alerta",
      "sonolento",
      "bocejo"
    ],
    "janela_ms": 2000,
    "intervalo_terminal_ms": 1000
  },
  "rosto": {
    "ear_olho_fechado": 0.18,
    "piscada_max_ms": 400,
    "olhos_fechados_alerta_ms": 1000,
    "abertura_boca_aberta": 0.4,
    "bocejo_min_ms": 1500
  },
  "sensor": {
    "porta": "/dev/ttyUSB0",
    "baud": 9600,
    "limiar_sonolencia": 400
  },
  "fusao": {
    "peso_modelo": 0.6,
    "peso_sensor": 0.4,
    "limiar_alerta": 0.6,
    "limiar_fim_alerta": 0.4
  }
}
