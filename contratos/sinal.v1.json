{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Face-Car — sinal v1",
  "description": "Um objeto por linha JSONL. ts e ttl em ms, ts no relógio monotônico compartilhado/sincronizado da sessão. Vence quando agora >= ts+ttl. seq é estritamente crescente entre ações e heartbeats da mesma sessão. Heartbeat informa saúde e nunca deve disparar ação. Em nova sessão, o receptor exige reinicialização explícita e esquece seq anterior.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versao",
    "sessao",
    "tipo",
    "seq",
    "ts",
    "ttl",
    "estado",
    "nivel",
    "acao",
    "indice",
    "confianca"
  ],
  "properties": {
    "versao": {
      "const": 1
    },
    "sessao": {
      "type": "string",
      "minLength": 1
    },
    "tipo": {
      "enum": [
        "acao",
        "heartbeat"
      ]
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ttl": {
      "type": "integer",
      "minimum": 1
    },
    "estado": {
      "enum": [
        "NORMAL",
        "ATENCAO",
        "ALERTA",
        "INTERVENCAO",
        "DEGRADADO"
      ]
    },
    "nivel": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "acao": {
      "enum": [
        "monitorar",
        "aviso_visual",
        "alarme_sonoro",
        "desacelerar_simulado",
        "sistema_degradado"
      ]
    },
    "indice": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "confianca": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "estado": {
            "const": "NORMAL"
          }
        }
      },
      "then": {
        "properties": {
          "nivel": {
            "const": 0
          },
          "acao": {
            "const": "monitorar"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "estado": {
            "const": "ATENCAO"
          }
        }
      },
      "then": {
        "properties": {
          "nivel": {
            "const": 1
          },
          "acao": {
            "const": "aviso_visual"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "estado": {
            "const": "ALERTA"
          }
        }
      },
      "then": {
        "properties": {
          "nivel": {
            "const": 2
          },
          "acao": {
            "const": "alarme_sonoro"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "estado": {
            "const": "INTERVENCAO"
          }
        }
      },
      "then": {
        "properties": {
          "nivel": {
            "const": 3
          },
          "acao": {
            "const": "desacelerar_simulado"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "estado": {
            "const": "DEGRADADO"
          }
        }
      },
      "then": {
        "properties": {
          "nivel": {
            "const": 0
          },
          "acao": {
            "const": "sistema_degradado"
          }
        }
      }
    }
  ]
}
